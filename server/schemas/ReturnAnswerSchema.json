{
    "$defs": {
        "NewReturnItem": {
            "description": "One item of a requestReturn call. Types only, no limits: the route\nchecks them, so a refusal names the item's position and never quotes\nthe value (NewOrderItem's reason).",
            "properties": {
                "item": {
                    "description": "The item's position in the order (1 is its first item)",
                    "title": "Item",
                    "type": "integer"
                },
                "quantity": {
                    "description": "Units to return",
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "item",
                "quantity"
            ],
            "title": "NewReturnItem",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A ReturnForm, filled in.",
    "properties": {
        "kind": {
            "const": "return",
            "description": "The answer",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "items": {
            "description": "What goes back",
            "items": {
                "$ref": "#/$defs/NewReturnItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        },
        "reason": {
            "description": "Why it goes back",
            "enum": [
                "changedMind",
                "defective",
                "wrongItem"
            ],
            "title": "Reason",
            "type": "string"
        },
        "note": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "For the store",
            "title": "Note"
        }
    },
    "required": [
        "kind",
        "formId",
        "items",
        "reason"
    ],
    "title": "ReturnAnswer",
    "type": "object",
    "additionalProperties": false
}