{
    "$defs": {
        "OrderItemRow": {
            "description": "One item of an order as a route sends it: OrderItem without its\nproductId. Each field restates OrderItem's, which\ntest_route_response_models.py's MIRRORS keeps in step.",
            "properties": {
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units ordered",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "name",
                "price",
                "quantity"
            ],
            "title": "OrderItemRow",
            "type": "object",
            "additionalProperties": false
        },
        "StoreOrderRow": {
            "description": "One order as its store's admin sees it. Each field restates\nOrder's, which test_route_response_models.py's MIRRORS keeps in\nstep.",
            "properties": {
                "_id": {
                    "description": "Orders _id",
                    "title": "Id",
                    "type": "string"
                },
                "status": {
                    "description": "Where the order is",
                    "enum": [
                        "pending",
                        "confirmed",
                        "completed",
                        "cancelled"
                    ],
                    "title": "Status",
                    "type": "string"
                },
                "items": {
                    "description": "What was ordered",
                    "items": {
                        "$ref": "#/$defs/OrderItemRow"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "title": "Items",
                    "type": "array"
                },
                "total": {
                    "description": "What the order costs",
                    "minimum": 0,
                    "title": "Total",
                    "type": "number"
                },
                "currency": {
                    "description": "ISO 4217 code of the store's currency when ordered",
                    "enum": [
                        "PHP",
                        "USD",
                        "EUR",
                        "GBP",
                        "JPY",
                        "SGD",
                        "AUD",
                        "CAD",
                        "HKD",
                        "CNY",
                        "KRW",
                        "MYR",
                        "THB",
                        "IDR",
                        "VND",
                        "INR",
                        "AED"
                    ],
                    "title": "Currency",
                    "type": "string"
                },
                "contactNumber": {
                    "description": "The customer's verified number",
                    "pattern": "^\\+[1-9][0-9]{6,14}$",
                    "title": "Contactnumber",
                    "type": "string"
                },
                "createdAt": {
                    "description": "When it was placed",
                    "format": "date-time",
                    "title": "Createdat",
                    "type": "string"
                }
            },
            "required": [
                "_id",
                "status",
                "items",
                "total",
                "currency",
                "contactNumber",
                "createdAt"
            ],
            "title": "StoreOrderRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "properties": {
        "orders": {
            "description": "The orders, newest first",
            "items": {
                "$ref": "#/$defs/StoreOrderRow"
            },
            "title": "Orders",
            "type": "array"
        }
    },
    "required": [
        "orders"
    ],
    "title": "StoreOrderListResponse",
    "type": "object",
    "additionalProperties": false
}