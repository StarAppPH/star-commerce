{
    "$defs": {
        "PhotoChoiceRow": {
            "description": "One photo the admin may put on the product.",
            "properties": {
                "_id": {
                    "description": "GeneratedPhotos _id",
                    "title": "Id",
                    "type": "string"
                },
                "url": {
                    "description": "Its download URL",
                    "minLength": 1,
                    "title": "Url",
                    "type": "string"
                },
                "source": {
                    "description": "Styled, or the original",
                    "enum": [
                        "generated",
                        "original"
                    ],
                    "title": "Source",
                    "type": "string"
                },
                "prompt": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The prompt the model was given for it; null for the original, and on a card saved before each photo carried its own",
                    "title": "Prompt"
                }
            },
            "required": [
                "_id",
                "url",
                "source"
            ],
            "title": "PhotoChoiceRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "What makeProductPhotoChoices sends: the product, its original photo\nfirst, then the ones made, each with its prompt.",
    "properties": {
        "productId": {
            "description": "The Products _id",
            "minLength": 1,
            "title": "Productid",
            "type": "string"
        },
        "productName": {
            "description": "Product name",
            "minLength": 1,
            "title": "Productname",
            "type": "string"
        },
        "photos": {
            "description": "The original first, then the photos made",
            "items": {
                "$ref": "#/$defs/PhotoChoiceRow"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Photos",
            "type": "array"
        },
        "notGenerated": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Why fewer photos than asked were made (no photo style, today's limit reached, generation unavailable); null when all were",
            "title": "Notgenerated"
        }
    },
    "required": [
        "productId",
        "productName",
        "photos",
        "notGenerated"
    ],
    "title": "ProductPhotoChoicesResponse",
    "type": "object",
    "additionalProperties": false
}