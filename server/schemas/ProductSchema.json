{
    "$defs": {
        "ReservedInventory": {
            "description": "Units of a product an order is holding (taken out of inventory).",
            "properties": {
                "orderId": {
                    "description": "The Orders _id",
                    "minLength": 1,
                    "title": "Orderid",
                    "type": "string"
                },
                "quantity": {
                    "description": "Units the order holds",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                },
                "tracked": {
                    "default": true,
                    "description": "Whether the units came out of inventory: false for a product with hasInventory false, so a cancel puts nothing back (missing in documents stored before: true). Stored only when false, as orders write it (OrderActions._reserveUnits)",
                    "title": "Tracked",
                    "type": "boolean"
                }
            },
            "required": [
                "orderId",
                "quantity"
            ],
            "title": "ReservedInventory",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Products document, priced in its store's currency. Listed best\nsellers first: the (storeId, isAvailable, soldCount, name) index\n(mongoDb.ensureIndexes) serves that sort. (storeId, nameKey) is a\nunique index: one store never has two products of the same name.\n\nEvery write to inventory or reservedInventory (an order reserving or\nreleasing units included) must also $inc _version, or\nupdateStoreProduct's _version lock misses it and the admin's save\noverwrites it.\n\nhasInventory false: customers order unlimited units; inventory stays 0\nand no order moves it. Documents stored before hasInventory read as\ntrue: every query matches {'hasInventory': {'$ne': False}}.",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "name": {
            "description": "Product name",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
        },
        "nameKey": {
            "description": "productNameKey(name), unique per store",
            "minLength": 1,
            "title": "Namekey",
            "type": "string"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 500,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What the product is",
            "title": "Description"
        },
        "price": {
            "description": "Price in the store's currency",
            "maximum": 10000000,
            "minimum": 0,
            "title": "Price",
            "type": "number"
        },
        "inventory": {
            "description": "Units free to sell; 0 is sold out",
            "maximum": 1000000,
            "minimum": 0,
            "title": "Inventory",
            "type": "integer"
        },
        "hasInventory": {
            "default": true,
            "description": "Decides whether this item has inventory, so when a customer orders it gets lessened. False: customers can order unlimited units (inventory is then 0 and never moves)",
            "title": "Hasinventory",
            "type": "boolean"
        },
        "reservedInventory": {
            "description": "Units orders are holding",
            "items": {
                "$ref": "#/$defs/ReservedInventory"
            },
            "title": "Reservedinventory",
            "type": "array"
        },
        "soldCount": {
            "default": 0,
            "description": "Units sold so far",
            "minimum": 0,
            "title": "Soldcount",
            "type": "integer"
        },
        "isAvailable": {
            "default": true,
            "description": "Shown to customers",
            "title": "Isavailable",
            "type": "boolean"
        },
        "createdAt": {
            "description": "When it was added",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "photoUrl": {
            "anyOf": [
                {
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The photo the shop shows: the url of one of the store's GeneratedPhotos (setProductPhoto)",
            "title": "Photourl"
        },
        "importFormId": {
            "anyOf": [
                {
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The formId of the spreadsheet import form that added it (ProductActions.importStoreProducts); left out otherwise",
            "title": "Importformid"
        }
    },
    "required": [
        "storeId",
        "name",
        "nameKey",
        "price",
        "inventory",
        "createdAt"
    ],
    "title": "Product",
    "type": "object",
    "additionalProperties": false
}