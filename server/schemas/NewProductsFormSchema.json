{
    "$defs": {
        "ChatProductDraft": {
            "description": "A product the admin mentioned, prefilled on the new products\nform.",
            "properties": {
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Product name",
                    "title": "Name"
                },
                "price": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Price",
                    "title": "Price"
                },
                "inventory": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Units in stock",
                    "title": "Inventory"
                },
                "hasInventory": {
                    "default": true,
                    "description": "Decides whether this item has inventory, so when a customer orders it gets lessened. False: customers can order unlimited units (inventory is then 0 and never moves)",
                    "title": "Hasinventory",
                    "type": "boolean"
                },
                "description": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "What it is",
                    "title": "Description"
                }
            },
            "required": [
                "name",
                "price",
                "inventory",
                "description"
            ],
            "title": "ChatProductDraft",
            "type": "object",
            "additionalProperties": false
        },
        "SpreadsheetImport": {
            "description": "Where a new products form's rows came from: a spreadsheet the admin\nattached (showNewProductsFromSpreadsheet). Its submit saves the\nproducts itself (chatForms._newProducts).",
            "properties": {
                "fileName": {
                    "description": "The spreadsheet's name",
                    "title": "Filename",
                    "type": "string"
                },
                "sheet": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The sheet read (an XLSX); null for a CSV",
                    "title": "Sheet"
                },
                "firstRow": {
                    "description": "The row number the range starts at (as the spreadsheet numbers its rows: the headers and empty rows counted)",
                    "title": "Firstrow",
                    "type": "integer"
                },
                "lastRow": {
                    "description": "The row number of the last product row read",
                    "title": "Lastrow",
                    "type": "integer"
                },
                "totalRows": {
                    "description": "How many product rows (rows with a value under the headers) the sheet has, as far as it could be read",
                    "title": "Totalrows",
                    "type": "integer"
                },
                "nextFirstRow": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The row number the next import starts at, when the sheet has product rows past lastRow; null otherwise",
                    "title": "Nextfirstrow"
                },
                "notFullyRead": {
                    "description": "The file is longer than what can be read at once: rows past totalRows cannot be imported from it",
                    "title": "Notfullyread",
                    "type": "boolean"
                },
                "skippedRows": {
                    "description": "The rows of the range left off the form",
                    "items": {
                        "$ref": "#/$defs/SpreadsheetImportSkippedRow"
                    },
                    "maxItems": 200,
                    "title": "Skippedrows",
                    "type": "array"
                }
            },
            "required": [
                "fileName",
                "sheet",
                "firstRow",
                "lastRow",
                "totalRows",
                "nextFirstRow",
                "notFullyRead",
                "skippedRows"
            ],
            "title": "SpreadsheetImport",
            "type": "object",
            "additionalProperties": false
        },
        "SpreadsheetImportSkippedRow": {
            "description": "A row of the sheet an import left off the form, and why.",
            "properties": {
                "row": {
                    "description": "The row's number, as the spreadsheet numbers its rows",
                    "title": "Row",
                    "type": "integer"
                },
                "name": {
                    "anyOf": [
                        {
                            "maxLength": 80,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Its name (cut to a name's length); null without one",
                    "title": "Name"
                },
                "reason": {
                    "description": "Why it was left out",
                    "title": "Reason",
                    "type": "string"
                }
            },
            "required": [
                "row",
                "name",
                "reason"
            ],
            "title": "SpreadsheetImportSkippedRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "Asks the admin for new products. Answered with NewProductsAnswer.",
    "properties": {
        "kind": {
            "const": "newProductsForm",
            "description": "The form",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "currency": {
            "description": "Prices are in it",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "products": {
            "description": "Prefilled rows: at most 50, or 200 from a spreadsheet",
            "items": {
                "$ref": "#/$defs/ChatProductDraft"
            },
            "maxItems": 200,
            "title": "Products",
            "type": "array"
        },
        "rowPhotos": {
            "description": "Each prefilled row's photo (by position): the Storage path of an image the owner attached; null without one",
            "items": {
                "anyOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "maxItems": 200,
            "title": "Rowphotos",
            "type": "array"
        },
        "spreadsheetImport": {
            "anyOf": [
                {
                    "$ref": "#/$defs/SpreadsheetImport"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Where the rows came from, when a spreadsheet: its submit then saves the products itself; left out otherwise"
        }
    },
    "required": [
        "kind",
        "formId",
        "currency",
        "products"
    ],
    "title": "NewProductsForm",
    "type": "object",
    "additionalProperties": false
}