            "title": "StoreLocationResponse",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A delivery area as a route sends it. Each field restates\nDeliveryZone's, which test_route_response_models.py's MIRRORS keeps\nin step.",
