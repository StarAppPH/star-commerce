{
    "$defs": {
        "ReturnItem": {
            "description": "One item of a return: a snapshot of the order's item (its productId,\nname and unit price paid), with the units returned as its quantity.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units returned",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "productId",
                "name",
                "price",
                "quantity"
            ],
            "title": "ReturnItem",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Returns document as stored.",
    "properties": {
        "_id": {
            "description": "Document _id",
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "description": "Optimistic-lock version",
            "title": "Version",
            "type": "integer"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "customerId": {
            "description": "The Customers _id",
            "minLength": 1,
            "title": "Customerid",
            "type": "string"
        },
        "orderId": {
            "description": "The Orders _id",
            "minLength": 1,
            "title": "Orderid",
            "type": "string"
        },
        "items": {
            "description": "What goes back",
            "items": {
                "$ref": "#/$defs/ReturnItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        },
        "reason": {
            "description": "Why it goes back",
            "enum": [
                "changedMind",
                "defective",
                "wrongItem"
            ],
            "title": "Reason",
            "type": "string"
        },
        "note": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The customer's note",
            "title": "Note"
        },
        "refundAmount": {
            "description": "What the return refunds",
            "minimum": 0,
            "title": "Refundamount",
            "type": "number"
        },
        "currency": {
            "description": "ISO 4217 code of the order's currency",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "contactNumber": {
            "description": "The customer's verified number",
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "title": "Contactnumber",
            "type": "string"
        },
        "status": {
            "description": "Where the return is",
            "enum": [
                "requested",
                "approved",
                "rejected",
                "received",
                "cancelled"
            ],
            "title": "Status",
            "type": "string"
        },
        "createdAt": {
            "description": "When it was requested",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "decidedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When the store approved or rejected it",
            "title": "Decidedat"
        },
        "rejectReason": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Why the store rejected it",
            "title": "Rejectreason"
        },
        "cancelledAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When the customer cancelled it",
            "title": "Cancelledat"
        },
        "receivedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When the store got the items back",
            "title": "Receivedat"
        },
        "restocked": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Whether the units went back in stock",
            "title": "Restocked"
        },
        "refundedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When it was refunded",
            "title": "Refundedat"
        },
        "refundReference": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The payment provider's id of the refund",
            "title": "Refundreference"
        }
    },
    "required": [
        "_id",
        "_version",
        "storeId",
        "customerId",
        "orderId",
        "items",
        "reason",
        "refundAmount",
        "currency",
        "contactNumber",
        "status",
        "createdAt"
    ],
    "title": "ReturnView",
    "type": "object",
    "additionalProperties": false
}