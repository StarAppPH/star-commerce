{
    "$defs": {
        "DeliveryZoneRule": {
            "description": "A zone's delivery policy as a route sends it, without its shape.\nEach field restates DeliveryZone's, which test_route_response_models.py's\nMIRRORS keeps in step.",
            "properties": {
                "name": {
                    "description": "What the zone is called, e.g. Makati",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "deliveryFee": {
                    "description": "What a delivery into the zone costs, in the store's currency; 0: free",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Deliveryfee",
                    "type": "number"
                },
                "deliveryDays": {
                    "description": "Days from payment until a delivery into the zone arrives",
                    "maximum": 365,
                    "minimum": 0,
                    "title": "Deliverydays",
                    "type": "integer"
                },
                "minimumOrder": {
                    "anyOf": [
                        {
                            "maximum": 10000000,
                            "minimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The smallest items total the zone takes, in the store's currency; null: no minimum",
                    "title": "Minimumorder"
                },
                "freeDeliveryFrom": {
                    "anyOf": [
                        {
                            "maximum": 10000000,
                            "minimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The items total from which delivery into the zone is free, in the store's currency; null: never free",
                    "title": "Freedeliveryfrom"
                }
            },
            "required": [
                "name",
                "deliveryFee",
                "deliveryDays",
                "minimumOrder",
                "freeDeliveryFrom"
            ],
            "title": "DeliveryZoneRule",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "The store's policy a tool read or saved: every answer, null while\nthe store has not said.",
    "properties": {
        "kind": {
            "const": "policy",
            "description": "The card",
            "title": "Kind",
            "type": "string"
        },
        "currency": {
            "description": "Fees are in it",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "acceptsReturns": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Whether a customer can return an item that is not defective",
            "title": "Acceptsreturns"
        },
        "returnWindowDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Days after handover a customer can return an item",
            "title": "Returnwindowdays"
        },
        "returnConditions": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "What a returned item must be like, e.g. unused with tags",
            "title": "Returnconditions"
        },
        "nonReturnableItems": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The items that can never be returned",
            "title": "Nonreturnableitems"
        },
        "refundMethod": {
            "anyOf": [
                {
                    "enum": [
                        "originalPayment",
                        "storeCredit",
                        "exchange"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "How a returned item is refunded",
            "title": "Refundmethod"
        },
        "returnShippingPaidBy": {
            "anyOf": [
                {
                    "enum": [
                        "customer",
                        "store"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Who pays the shipping of a returned item",
            "title": "Returnshippingpaidby"
        },
        "defectReportDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Days after handover a customer has to report a defective or wrong item",
            "title": "Defectreportdays"
        },
        "deliveryOptions": {
            "anyOf": [
                {
                    "items": {
                        "enum": [
                            "pickup",
                            "delivery"
                        ],
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "How a customer can get an order",
            "title": "Deliveryoptions"
        },
        "deliveryAreas": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Where the store delivers",
            "title": "Deliveryareas"
        },
        "handoverDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 0,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Days from payment until a pickup order is ready (a delivery takes its zone's deliveryDays)",
            "title": "Handoverdays"
        },
        "acceptedPaymentMethods": {
            "anyOf": [
                {
                    "items": {
                        "enum": [
                            "card",
                            "gcash",
                            "maya",
                            "grabPay",
                            "bankTransfer"
                        ],
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The ways a customer can pay",
            "title": "Acceptedpaymentmethods"
        },
        "paidOrderCancellation": {
            "anyOf": [
                {
                    "enum": [
                        "notAllowed",
                        "beforeHandover",
                        "withinHours"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Whether a customer can cancel a paid order",
            "title": "Paidordercancellation"
        },
        "paidOrderCancellationHours": {
            "anyOf": [
                {
                    "maximum": 168,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Hours after payment a customer can cancel a paid order (before handover), with paidOrderCancellation withinHours",
            "title": "Paidordercancellationhours"
        },
        "sendsMarketingMessages": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Whether the store messages customers about offers",
            "title": "Sendsmarketingmessages"
        },
        "additionalTerms": {
            "anyOf": [
                {
                    "maxLength": 1000,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Any other terms, as the admin gave them",
            "title": "Additionalterms"
        },
        "deliveryZones": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/DeliveryZoneRule"
                    },
                    "maxItems": 10,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The store's delivery zones and their policies",
            "title": "Deliveryzones"
        }
    },
    "required": [
        "kind",
        "currency",
        "acceptsReturns",
        "returnWindowDays",
        "returnConditions",
        "nonReturnableItems",
        "refundMethod",
        "returnShippingPaidBy",
        "defectReportDays",
        "deliveryOptions",
        "deliveryAreas",
        "handoverDays",
        "acceptedPaymentMethods",
        "paidOrderCancellation",
        "paidOrderCancellationHours",
        "sendsMarketingMessages",
        "additionalTerms"
    ],
    "title": "PolicyCard",
    "type": "object",
    "additionalProperties": false
}