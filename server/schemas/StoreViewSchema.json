{
    "$defs": {
        "StoreLocation": {
            "description": "Where a store is on the map, pinned by its admin.",
            "properties": {
                "latitude": {
                    "description": "Degrees north (negative: south)",
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "description": "Degrees east (negative: west)",
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                }
            },
            "required": [
                "latitude",
                "longitude"
            ],
            "title": "StoreLocation",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Stores document as stored.",
    "properties": {
        "_id": {
            "description": "Document _id",
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "description": "Optimistic-lock version",
            "title": "Version",
            "type": "integer"
        },
        "ownerUserId": {
            "description": "The admin's Users _id",
            "minLength": 1,
            "title": "Owneruserid",
            "type": "string"
        },
        "name": {
            "anyOf": [
                {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Store name shown to customers",
            "title": "Name"
        },
        "slug": {
            "anyOf": [
                {
                    "maxLength": 50,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The store's link name, e.g. bakery-a",
            "title": "Slug"
        },
        "currency": {
            "description": "ISO 4217 code every price of the store is in",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What the store sells",
            "title": "Description"
        },
        "contactNumber": {
            "anyOf": [
                {
                    "pattern": "^\\+[1-9][0-9]{6,14}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Contact number, E.164",
            "title": "Contactnumber"
        },
        "address": {
            "anyOf": [
                {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Street address, as the admin typed it",
            "title": "Address"
        },
        "openingHours": {
            "anyOf": [
                {
                    "maxLength": 100,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Opening hours, free text",
            "title": "Openinghours"
        },
        "location": {
            "anyOf": [
                {
                    "$ref": "#/$defs/StoreLocation"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Map location; null until the admin pins it"
        },
        "createdAt": {
            "description": "When it was created",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        }
    },
    "required": [
        "_id",
        "_version",
        "ownerUserId",
        "currency",
        "createdAt"
    ],
    "title": "StoreView",
    "type": "object",
    "additionalProperties": false
}