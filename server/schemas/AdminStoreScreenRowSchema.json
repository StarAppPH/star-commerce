{
    "description": "The admin's own store as the admin workspace shows it (the\ngetUserStore route): only what its screens read, the name (the title,\nthe sidebar, the reset dialog), the link name (Open my store) and the\nbrand colors the screens are drawn in. The AI's getUserStore tool sends\nthe whole AdminStoreResponse. A brand color is sent only once set. Each\nfield restates Store's (test_route_response_models.py's MIRRORS).",
    "properties": {
        "name": {
            "anyOf": [
                {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Store name shown to customers",
            "title": "Name"
        },
        "slug": {
            "anyOf": [
                {
                    "maxLength": 50,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The store's link name, e.g. bakery-a",
            "title": "Slug"
        },
        "primaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Main brand color, #RRGGBB",
            "title": "Primarycolor"
        },
        "secondaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Second brand color, #RRGGBB",
            "title": "Secondarycolor"
        }
    },
    "title": "AdminStoreScreenRow",
    "type": "object",
    "additionalProperties": false
}