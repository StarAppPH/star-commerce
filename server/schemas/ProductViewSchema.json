{
    "$defs": {
        "ReservedInventory": {
            "description": "Units of a product an order is holding (taken out of inventory).",
            "properties": {
                "orderId": {
                    "description": "The Orders _id",
                    "minLength": 1,
                    "title": "Orderid",
                    "type": "string"
                },
                "quantity": {
                    "description": "Units the order holds",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "orderId",
                "quantity"
            ],
            "title": "ReservedInventory",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Products document as stored.",
    "properties": {
        "_id": {
            "description": "Document _id",
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "description": "Optimistic-lock version",
            "title": "Version",
            "type": "integer"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "name": {
            "description": "Product name",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
        },
        "nameKey": {
            "description": "productNameKey(name), unique per store",
            "minLength": 1,
            "title": "Namekey",
            "type": "string"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 500,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What the product is",
            "title": "Description"
        },
        "price": {
            "description": "Price in the store's currency",
            "maximum": 10000000,
            "minimum": 0,
            "title": "Price",
            "type": "number"
        },
        "inventory": {
            "description": "Units free to sell; 0 is sold out",
            "maximum": 1000000,
            "minimum": 0,
            "title": "Inventory",
            "type": "integer"
        },
        "reservedInventory": {
            "description": "Units orders are holding",
            "items": {
                "$ref": "#/$defs/ReservedInventory"
            },
            "title": "Reservedinventory",
            "type": "array"
        },
        "soldCount": {
            "default": 0,
            "description": "Units sold so far",
            "minimum": 0,
            "title": "Soldcount",
            "type": "integer"
        },
        "isAvailable": {
            "default": true,
            "description": "Shown to customers",
            "title": "Isavailable",
            "type": "boolean"
        },
        "createdAt": {
            "description": "When it was added",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "photoUrl": {
            "anyOf": [
                {
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The photo the shop shows: the url of one of the store's GeneratedPhotos (setProductPhoto)",
            "title": "Photourl"
        }
    },
    "required": [
        "_id",
        "_version",
        "storeId",
        "name",
        "nameKey",
        "price",
        "inventory",
        "createdAt"
    ],
    "title": "ProductView",
    "type": "object",
    "additionalProperties": false
}