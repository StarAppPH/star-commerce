{
    "$defs": {
        "BankAccountRow": {
            "description": "BankAccount as a route sends it (MIRRORS keeps it in step).",
            "properties": {
                "bankName": {
                    "description": "The bank, e.g. BDO",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Bankname",
                    "type": "string"
                },
                "accountName": {
                    "description": "The name the account is under, as the bank has it",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Accountname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "bankName",
                "accountName",
                "accountNumber"
            ],
            "title": "BankAccountRow",
            "type": "object",
            "additionalProperties": false
        },
        "EwalletAccountRow": {
            "description": "EwalletAccount as a route sends it. Each field restates\nEwalletAccount's, which test_route_response_models.py's MIRRORS keeps\nin step.",
            "properties": {
                "ewalletName": {
                    "description": "The e-wallet, e.g. GCash",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Ewalletname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "ewalletName",
                "accountNumber"
            ],
            "title": "EwalletAccountRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "One way a customer can pay an order at checkout, as payOrder takes\nit (paymentMethod and paymentProvider). With a provider it is paid\nthere and then; without one it is paid by hand to the store, to the\naccounts listed (none for cash), and the store confirms it.",
    "properties": {
        "method": {
            "description": "The way to pay",
            "enum": [
                "cash",
                "card",
                "eWallet",
                "bankTransfer",
                "check",
                "crypto"
            ],
            "title": "Method",
            "type": "string"
        },
        "provider": {
            "anyOf": [
                {
                    "const": "demo",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The payment provider that takes it; null: paid by hand to the store, which then confirms it",
            "title": "Provider"
        },
        "eWallets": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/EwalletAccountRow"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "A manual eWallet: the store's accounts to pay to",
            "title": "Ewallets"
        },
        "banks": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/BankAccountRow"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "bankTransfer: the store's accounts to transfer to",
            "title": "Banks"
        },
        "checkPayees": {
            "anyOf": [
                {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "check: the names a check is made out to",
            "title": "Checkpayees"
        }
    },
    "required": [
        "method",
        "provider",
        "eWallets",
        "banks",
        "checkPayees"
    ],
    "title": "PaymentOption",
    "type": "object",
    "additionalProperties": false
}