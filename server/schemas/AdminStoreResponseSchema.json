{
    "$defs": {
        "StoreLocationResponse": {
            "description": "A store's map location as a route sends it. Each field restates\nStoreLocation's, which test_route_response_models.py's MIRRORS keeps\nin step.",
            "properties": {
                "latitude": {
                    "description": "Degrees north (negative: south)",
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "description": "Degrees east (negative: west)",
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                }
            },
            "required": [
                "latitude",
                "longitude"
            ],
            "title": "StoreLocationResponse",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "The admin's own store: a StoreResponse plus its photo theme and\nvoice, which customers never get (they feed the product photos and the\nspoken replies, not the storefront). Each is sent only once set (a dict the route builds leaves it\nout, and exclude_if drops it from a dump), so a store with no theme\nreads exactly as a StoreResponse. Each field restates Store's\n(test_route_response_models.py's MIRRORS).",
    "properties": {
        "_id": {
            "description": "Stores _id",
            "title": "Id",
            "type": "string"
        },
        "name": {
            "anyOf": [
                {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Store name shown to customers",
            "title": "Name"
        },
        "slug": {
            "anyOf": [
                {
                    "maxLength": 50,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The store's link name, e.g. bakery-a",
            "title": "Slug"
        },
        "currency": {
            "description": "ISO 4217 code every price of the store is in",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What the store sells",
            "title": "Description"
        },
        "contactNumber": {
            "anyOf": [
                {
                    "pattern": "^\\+[1-9][0-9]{6,14}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Contact number, E.164",
            "title": "Contactnumber"
        },
        "address": {
            "anyOf": [
                {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Street address, as the admin typed it",
            "title": "Address"
        },
        "openingHours": {
            "anyOf": [
                {
                    "maxLength": 100,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Opening hours, free text",
            "title": "Openinghours"
        },
        "location": {
            "anyOf": [
                {
                    "$ref": "#/$defs/StoreLocationResponse"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Map location; null until the admin pins it"
        },
        "photoStyle": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The look of the store's product photos",
            "title": "Photostyle"
        },
        "primaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Main brand color, #RRGGBB",
            "title": "Primarycolor"
        },
        "secondaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Second brand color, #RRGGBB",
            "title": "Secondarycolor"
        },
        "voiceId": {
            "anyOf": [
                {
                    "pattern": "^[A-Za-z0-9]{1,64}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The ElevenLabs voice its assistant speaks with; null: the default voice",
            "title": "Voiceid"
        }
    },
    "required": [
        "_id",
        "currency",
        "openingHours",
        "location"
    ],
    "title": "AdminStoreResponse",
    "type": "object",
    "additionalProperties": false
}