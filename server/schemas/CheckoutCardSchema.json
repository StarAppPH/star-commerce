{
    "$defs": {
        "BankAccountRow": {
            "description": "BankAccount as a route sends it (MIRRORS keeps it in step).",
            "properties": {
                "bankName": {
                    "description": "The bank, e.g. BDO",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Bankname",
                    "type": "string"
                },
                "accountName": {
                    "description": "The name the account is under, as the bank has it",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Accountname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "bankName",
                "accountName",
                "accountNumber"
            ],
            "title": "BankAccountRow",
            "type": "object",
            "additionalProperties": false
        },
        "ChatMyOrderRow": {
            "description": "An order on a shopper's order card.",
            "properties": {
                "fulfillment": {
                    "description": "How the customer gets it: pickup or delivery",
                    "enum": [
                        "pickup",
                        "delivery"
                    ],
                    "title": "Fulfillment",
                    "type": "string"
                },
                "deliveryFee": {
                    "description": "What delivery adds to the total",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Deliveryfee",
                    "type": "number"
                },
                "deliveryDistanceKm": {
                    "anyOf": [
                        {
                            "maximum": 20100,
                            "minimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Km from the store's pin to the delivery pin, in a straight line: what the fee was priced on, for a delivery priced per km before delivery zones; null since",
                    "title": "Deliverydistancekm"
                },
                "deliveryZone": {
                    "anyOf": [
                        {
                            "maxLength": 40,
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The delivery zone whose policy priced it; null for a pickup, or a delivery from before delivery zones",
                    "title": "Deliveryzone"
                },
                "deliveryAddress": {
                    "anyOf": [
                        {
                            "maxLength": 200,
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Where it is delivered, as the customer typed it",
                    "title": "Deliveryaddress"
                },
                "deliveryLatitude": {
                    "anyOf": [
                        {
                            "maximum": 90,
                            "minimum": -90,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The delivery pin's degrees north",
                    "title": "Deliverylatitude"
                },
                "deliveryLongitude": {
                    "anyOf": [
                        {
                            "maximum": 180,
                            "minimum": -180,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The delivery pin's degrees east",
                    "title": "Deliverylongitude"
                },
                "deliveryNotes": {
                    "anyOf": [
                        {
                            "maxLength": 300,
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The customer's notes for the delivery",
                    "title": "Deliverynotes"
                },
                "_id": {
                    "description": "Orders _id",
                    "title": "Id",
                    "type": "string"
                },
                "status": {
                    "description": "Where the order is",
                    "enum": [
                        "pending",
                        "awaitingPayment",
                        "paid",
                        "completed",
                        "cancelled"
                    ],
                    "title": "Status",
                    "type": "string"
                },
                "items": {
                    "description": "What was ordered",
                    "items": {
                        "$ref": "#/$defs/OrderItemRow"
                    },
                    "title": "Items",
                    "type": "array"
                },
                "total": {
                    "description": "What the order costs",
                    "minimum": 0,
                    "title": "Total",
                    "type": "number"
                },
                "currency": {
                    "description": "The order's currency",
                    "enum": [
                        "PHP",
                        "USD",
                        "EUR",
                        "GBP",
                        "JPY",
                        "SGD",
                        "AUD",
                        "CAD",
                        "HKD",
                        "CNY",
                        "KRW",
                        "MYR",
                        "THB",
                        "IDR",
                        "VND",
                        "INR",
                        "AED"
                    ],
                    "title": "Currency",
                    "type": "string"
                },
                "createdAt": {
                    "description": "When it was placed",
                    "format": "date-time",
                    "title": "Createdat",
                    "type": "string"
                },
                "expiresAt": {
                    "description": "Unpaid by then, it is cancelled",
                    "format": "date-time",
                    "title": "Expiresat",
                    "type": "string"
                },
                "paymentMethod": {
                    "anyOf": [
                        {
                            "enum": [
                                "cash",
                                "card",
                                "eWallet",
                                "bankTransfer",
                                "check",
                                "crypto",
                                "gcash",
                                "maya",
                                "grabPay"
                            ],
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How it is or was paid",
                    "title": "Paymentmethod"
                },
                "paidAt": {
                    "anyOf": [
                        {
                            "format": "date-time",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "When it was paid",
                    "title": "Paidat"
                },
                "completedAt": {
                    "anyOf": [
                        {
                            "format": "date-time",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "When it was handed over",
                    "title": "Completedat"
                },
                "cancelReason": {
                    "anyOf": [
                        {
                            "enum": [
                                "expired",
                                "byStore",
                                "byCustomer"
                            ],
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Why it was cancelled",
                    "title": "Cancelreason"
                },
                "refundedAt": {
                    "anyOf": [
                        {
                            "format": "date-time",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "When its payment was refunded",
                    "title": "Refundedat"
                },
                "paymentReceiptAt": {
                    "anyOf": [
                        {
                            "format": "date-time",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "When the shopper sent the photo of its receipt",
                    "title": "Paymentreceiptat"
                }
            },
            "required": [
                "fulfillment",
                "deliveryFee",
                "deliveryDistanceKm",
                "deliveryZone",
                "deliveryAddress",
                "deliveryLatitude",
                "deliveryLongitude",
                "deliveryNotes",
                "_id",
                "status",
                "items",
                "total",
                "currency",
                "createdAt",
                "expiresAt",
                "paymentMethod",
                "paidAt",
                "completedAt",
                "cancelReason",
                "refundedAt"
            ],
            "title": "ChatMyOrderRow",
            "type": "object",
            "additionalProperties": false
        },
        "EwalletAccountRow": {
            "description": "EwalletAccount as a route sends it. Each field restates\nEwalletAccount's, which test_route_response_models.py's MIRRORS keeps\nin step.",
            "properties": {
                "ewalletName": {
                    "description": "The e-wallet, e.g. GCash",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Ewalletname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "ewalletName",
                "accountNumber"
            ],
            "title": "EwalletAccountRow",
            "type": "object",
            "additionalProperties": false
        },
        "OrderItemRow": {
            "description": "One item of an order as a route sends it: OrderItem without its\nproductId. Each field restates OrderItem's, which\ntest_route_response_models.py's MIRRORS keeps in step.",
            "properties": {
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units ordered",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "name",
                "price",
                "quantity"
            ],
            "title": "OrderItemRow",
            "type": "object",
            "additionalProperties": false
        },
        "PaymentOption": {
            "description": "One way a customer can pay an order at checkout, as payOrder takes\nit (paymentMethod and paymentProvider). With a provider it is paid\nthere and then; without one it is paid by hand to the store, to the\naccounts listed (none for cash), and the store confirms it.",
            "properties": {
                "method": {
                    "description": "The way to pay",
                    "enum": [
                        "cash",
                        "card",
                        "eWallet",
                        "bankTransfer",
                        "check",
                        "crypto"
                    ],
                    "title": "Method",
                    "type": "string"
                },
                "provider": {
                    "anyOf": [
                        {
                            "const": "demo",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The payment provider that takes it; null: paid by hand to the store, which then confirms it",
                    "title": "Provider"
                },
                "eWallets": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/EwalletAccountRow"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "A manual eWallet: the store's accounts to pay to",
                    "title": "Ewallets"
                },
                "banks": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/BankAccountRow"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "bankTransfer: the store's accounts to transfer to",
                    "title": "Banks"
                },
                "checkPayees": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "check: the names a check is made out to",
                    "title": "Checkpayees"
                }
            },
            "required": [
                "method",
                "provider",
                "eWallets",
                "banks",
                "checkPayees"
            ],
            "title": "PaymentOption",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "The order a shopper just placed, unpaid. Answered with PaymentAnswer:\nthe payment method the shopper picked.",
    "properties": {
        "kind": {
            "const": "checkout",
            "description": "The card",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "order": {
            "allOf": [
                {
                    "$ref": "#/$defs/ChatMyOrderRow"
                }
            ],
            "description": "The order to pay"
        },
        "paymentOptions": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/PaymentOption"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The ways the shopper can pay it (never none)",
            "title": "Paymentoptions"
        },
        "paymentMethods": {
            "anyOf": [
                {
                    "items": {
                        "enum": [
                            "cash",
                            "card",
                            "eWallet",
                            "bankTransfer",
                            "check",
                            "crypto",
                            "gcash",
                            "maya",
                            "grabPay"
                        ],
                        "type": "string"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The ways the shopper could pay it, on a card saved before payment options",
            "title": "Paymentmethods"
        }
    },
    "required": [
        "kind",
        "formId",
        "order"
    ],
    "title": "CheckoutCard",
    "type": "object",
    "additionalProperties": false
}