{
    "$defs": {
        "NewProductAnswerRow": {
            "description": "A NewProductsForm row: a product to add, and the photo the admin\nuploaded for it, if any.",
            "properties": {
                "name": {
                    "description": "Product name",
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Price in the store's currency",
                    "title": "Price",
                    "type": "number"
                },
                "inventory": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Units in stock, free to sell; required unless hasInventory is false",
                    "title": "Inventory"
                },
                "description": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "What the product is",
                    "title": "Description"
                },
                "isAvailable": {
                    "default": true,
                    "description": "Shown to customers",
                    "title": "Isavailable",
                    "type": "boolean"
                },
                "hasInventory": {
                    "default": true,
                    "description": "Decides whether this item has inventory, so when a customer orders it gets lessened. False: customers can order unlimited units (inventory is then 0 and never moves)",
                    "title": "Hasinventory",
                    "type": "boolean"
                },
                "imageUrl": {
                    "anyOf": [
                        {
                            "maxLength": 2048,
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The uploaded photo's download URL; null without one",
                    "title": "Imageurl"
                }
            },
            "required": [
                "name",
                "price"
            ],
            "title": "NewProductAnswerRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A NewProductsForm, filled in.",
    "properties": {
        "kind": {
            "const": "newProducts",
            "description": "The answer",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "products": {
            "description": "The products to add: at most 50, or 200 on a form from a spreadsheet",
            "items": {
                "$ref": "#/$defs/NewProductAnswerRow"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Products",
            "type": "array"
        }
    },
    "required": [
        "kind",
        "formId",
        "products"
    ],
    "title": "NewProductsAnswer",
    "type": "object",
    "additionalProperties": false
}