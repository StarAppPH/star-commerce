{
    "$defs": {
        "AuthorizedPaymentMethod": {
            "description": "A way the store takes payment, with what a customer needs to pay\nthat way: cash nothing; card and crypto their provider; eWallet the\nstore's own accounts, a provider, or both; bankTransfer the store's\nbank accounts; check the names a check is made out to.",
            "properties": {
                "method": {
                    "description": "The way to pay",
                    "enum": [
                        "cash",
                        "card",
                        "eWallet",
                        "bankTransfer",
                        "check",
                        "crypto"
                    ],
                    "title": "Method",
                    "type": "string"
                },
                "provider": {
                    "anyOf": [
                        {
                            "const": "demo",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The payment provider that takes it; null: paid by hand to the store only",
                    "title": "Provider"
                },
                "eWallets": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/EwalletAccount"
                            },
                            "maxItems": 10,
                            "minItems": 1,
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "eWallet: the store's own accounts, paid to by hand",
                    "title": "Ewallets"
                },
                "banks": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/BankAccount"
                            },
                            "maxItems": 10,
                            "minItems": 1,
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "bankTransfer: the store's bank accounts",
                    "title": "Banks"
                },
                "checkPayees": {
                    "anyOf": [
                        {
                            "items": {
                                "description": "The account name a check is made out to",
                                "maxLength": 100,
                                "minLength": 1,
                                "type": "string"
                            },
                            "maxItems": 10,
                            "minItems": 1,
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "check: the account names a check is made out to",
                    "title": "Checkpayees"
                }
            },
            "required": [
                "method"
            ],
            "title": "AuthorizedPaymentMethod",
            "type": "object",
            "additionalProperties": false
        },
        "BankAccount": {
            "description": "One of the store's bank accounts a customer transfers to by hand.",
            "properties": {
                "bankName": {
                    "description": "The bank, e.g. BDO",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Bankname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "bankName",
                "accountNumber"
            ],
            "title": "BankAccount",
            "type": "object",
            "additionalProperties": false
        },
        "EwalletAccount": {
            "description": "One of the store's own e-wallet accounts a customer pays to by\nhand.",
            "properties": {
                "ewalletName": {
                    "description": "The e-wallet, e.g. GCash",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Ewalletname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "ewalletName",
                "accountNumber"
            ],
            "title": "EwalletAccount",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Policies document: the store's answers to what customers ask\n(returns, delivery, payment), one per store (the unique storeId index,\nmongoDb.ensureIndexes). Every answer is None until the admin gives it:\nNone is \"the store has not said\".\n\nRules the app enforces itself (the payment window, a customer\ncancelling an unpaid order) are no fields here, so a policy can never\ncontradict the code. Every write must $inc _version\n(updateMyStorePolicy's lock).",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "acceptsReturns": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Whether a customer can return an item that is not defective",
            "title": "Acceptsreturns"
        },
        "returnWindowDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Days after handover a customer can return an item",
            "title": "Returnwindowdays"
        },
        "returnConditions": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What a returned item must be like, e.g. unused with tags",
            "title": "Returnconditions"
        },
        "nonReturnableItems": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The items that can never be returned",
            "title": "Nonreturnableitems"
        },
        "refundMethod": {
            "anyOf": [
                {
                    "enum": [
                        "originalPayment",
                        "storeCredit",
                        "exchange"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "How a returned item is refunded",
            "title": "Refundmethod"
        },
        "returnShippingPaidBy": {
            "anyOf": [
                {
                    "enum": [
                        "customer",
                        "store"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Who pays the shipping of a returned item",
            "title": "Returnshippingpaidby"
        },
        "defectReportDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Days after handover a customer has to report a defective or wrong item",
            "title": "Defectreportdays"
        },
        "deliveryOptions": {
            "anyOf": [
                {
                    "items": {
                        "enum": [
                            "pickup",
                            "delivery"
                        ],
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "How a customer can get an order",
            "title": "Deliveryoptions"
        },
        "deliveryAreas": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Where the store delivers",
            "title": "Deliveryareas"
        },
        "handoverDays": {
            "anyOf": [
                {
                    "maximum": 365,
                    "minimum": 0,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Days from payment until a pickup order is ready (a delivery takes its zone's deliveryDays)",
            "title": "Handoverdays"
        },
        "authorizedPaymentMethods": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/AuthorizedPaymentMethod"
                    },
                    "maxItems": 6,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The ways a customer can pay, each with what paying that way needs",
            "title": "Authorizedpaymentmethods"
        },
        "paidOrderCancellation": {
            "anyOf": [
                {
                    "enum": [
                        "notAllowed",
                        "beforeHandover",
                        "withinHours"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Whether a customer can cancel a paid order",
            "title": "Paidordercancellation"
        },
        "paidOrderCancellationHours": {
            "anyOf": [
                {
                    "maximum": 168,
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Hours after payment a customer can cancel a paid order (before handover), with paidOrderCancellation withinHours",
            "title": "Paidordercancellationhours"
        },
        "additionalTerms": {
            "anyOf": [
                {
                    "maxLength": 1000,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Any other terms, as the admin gave them",
            "title": "Additionalterms"
        },
        "createdAt": {
            "description": "When it was created",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "updatedAt": {
            "description": "When it last changed",
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
        }
    },
    "required": [
        "storeId",
        "createdAt",
        "updatedAt"
    ],
    "title": "Policy",
    "type": "object",
    "additionalProperties": false
}