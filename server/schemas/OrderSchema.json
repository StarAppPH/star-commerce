{
    "$defs": {
        "OrderItem": {
            "description": "One product of an order, a snapshot taken when the order is placed:\na later change of the product's name or price never rewrites it.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units ordered",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "productId",
                "name",
                "price",
                "quantity"
            ],
            "title": "OrderItem",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "An Orders document, read newest first: the (storeId, status,\ncreatedAt) and (customerId, storeId, createdAt) indexes\n(mongoDb.ensureIndexes) serve the admin's and the customer's lists.\n\nEvery write to a product's inventory or reservedInventory an order\nmakes (placing, cancelling or completing it) must also $inc the\nproduct's _version, or updateStoreProduct's _version lock misses it and\nthe admin's save overwrites it.",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "customerId": {
            "description": "The Customers _id",
            "minLength": 1,
            "title": "Customerid",
            "type": "string"
        },
        "items": {
            "description": "What was ordered",
            "items": {
                "$ref": "#/$defs/OrderItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        },
        "total": {
            "description": "What the order costs",
            "minimum": 0,
            "title": "Total",
            "type": "number"
        },
        "currency": {
            "description": "ISO 4217 code of the store's currency when ordered",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "contactNumber": {
            "description": "The customer's verified number",
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "title": "Contactnumber",
            "type": "string"
        },
        "status": {
            "description": "Where the order is",
            "enum": [
                "pending",
                "confirmed",
                "completed",
                "cancelled"
            ],
            "title": "Status",
            "type": "string"
        },
        "createdAt": {
            "description": "When it was placed",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        }
    },
    "required": [
        "storeId",
        "customerId",
        "items",
        "total",
        "currency",
        "contactNumber",
        "status",
        "createdAt"
    ],
    "title": "Order",
    "type": "object",
    "additionalProperties": false
}