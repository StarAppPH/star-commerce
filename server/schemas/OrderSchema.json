{
    "$defs": {
        "OrderItem": {
            "description": "One product of an order, a snapshot taken when the order is placed:\na later change of the product's name or price never rewrites it.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units ordered",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "productId",
                "name",
                "price",
                "quantity"
            ],
            "title": "OrderItem",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "An Orders document, read newest first: the (storeId, status,\ncreatedAt) and (customerId, storeId, createdAt) indexes\n(mongoDb.ensureIndexes) serve the admin's and the customer's lists,\n(status, expiresAt) and (storeId, status, expiresAt) the sweeps of\nexpired unpaid orders.\n\nEvery write to a product's inventory or reservedInventory an order\nmakes (placing, cancelling or completing it) must also $inc the\nproduct's _version, or updateStoreProduct's _version lock misses it and\nthe admin's save overwrites it.",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "storeId": {
            "description": "The Stores _id",
            "minLength": 1,
            "title": "Storeid",
            "type": "string"
        },
        "customerId": {
            "description": "The Customers _id",
            "minLength": 1,
            "title": "Customerid",
            "type": "string"
        },
        "items": {
            "description": "What was ordered",
            "items": {
                "$ref": "#/$defs/OrderItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        },
        "total": {
            "description": "What the order costs",
            "minimum": 0,
            "title": "Total",
            "type": "number"
        },
        "currency": {
            "description": "ISO 4217 code of the store's currency when ordered",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "contactNumber": {
            "description": "The customer's verified number",
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "title": "Contactnumber",
            "type": "string"
        },
        "status": {
            "description": "Where the order is",
            "enum": [
                "pending",
                "awaitingPayment",
                "paid",
                "completed",
                "cancelled"
            ],
            "title": "Status",
            "type": "string"
        },
        "createdAt": {
            "description": "When it was placed",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "expiresAt": {
            "description": "Still pending (no way to pay chosen) by then, it is cancelled (UTC)",
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
        },
        "paymentMethod": {
            "anyOf": [
                {
                    "enum": [
                        "cash",
                        "card",
                        "eWallet",
                        "bankTransfer",
                        "check",
                        "crypto",
                        "gcash",
                        "maya",
                        "grabPay"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "How the customer pays or paid",
            "title": "Paymentmethod"
        },
        "paymentProvider": {
            "anyOf": [
                {
                    "const": "demo",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The payment provider it was paid through; null: paid by hand to the store (or not chosen yet)",
            "title": "Paymentprovider"
        },
        "paymentReference": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The payment provider's id of the payment",
            "title": "Paymentreference"
        },
        "manualPaymentReference": {
            "anyOf": [
                {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The reference the customer gave for a payment made by hand, e.g. a bank transfer's",
            "title": "Manualpaymentreference"
        },
        "paidAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When it was paid",
            "title": "Paidat"
        },
        "cancelledAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When it was cancelled",
            "title": "Cancelledat"
        },
        "cancelReason": {
            "anyOf": [
                {
                    "enum": [
                        "expired",
                        "byStore",
                        "byCustomer"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Why it was cancelled",
            "title": "Cancelreason"
        },
        "completedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When it was handed over",
            "title": "Completedat"
        },
        "refundedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "When its payment was refunded",
            "title": "Refundedat"
        },
        "refundReference": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The payment provider's id of the refund",
            "title": "Refundreference"
        },
        "fulfillment": {
            "default": "pickup",
            "description": "How the customer gets it: pickup or delivery",
            "enum": [
                "pickup",
                "delivery"
            ],
            "title": "Fulfillment",
            "type": "string"
        },
        "deliveryFee": {
            "default": 0,
            "description": "What delivery adds to the total",
            "maximum": 10000000,
            "minimum": 0,
            "title": "Deliveryfee",
            "type": "number"
        },
        "deliveryDistanceKm": {
            "anyOf": [
                {
                    "maximum": 20100,
                    "minimum": 0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Km from the store's pin to the delivery pin, in a straight line: what the fee was priced on, for a delivery priced per km before delivery zones; null since",
            "title": "Deliverydistancekm"
        },
        "deliveryZone": {
            "anyOf": [
                {
                    "maxLength": 40,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The delivery zone whose policy priced it; null for a pickup, or a delivery from before delivery zones",
            "title": "Deliveryzone"
        },
        "deliveryAddress": {
            "anyOf": [
                {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Where it is delivered, as the customer typed it",
            "title": "Deliveryaddress"
        },
        "deliveryLatitude": {
            "anyOf": [
                {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The delivery pin's degrees north",
            "title": "Deliverylatitude"
        },
        "deliveryLongitude": {
            "anyOf": [
                {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The delivery pin's degrees east",
            "title": "Deliverylongitude"
        },
        "deliveryNotes": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The customer's notes for the delivery",
            "title": "Deliverynotes"
        }
    },
    "required": [
        "storeId",
        "customerId",
        "items",
        "total",
        "currency",
        "contactNumber",
        "status",
        "createdAt",
        "expiresAt"
    ],
    "title": "Order",
    "type": "object",
    "additionalProperties": false
}