{
    "$defs": {
        "ChatAttachmentRow": {
            "description": "One file of a turn of getConversationTurns, which the client reads\nthrough the Storage SDK by its path (the owner's own folder). Each\nfield restates ChatAttachment's.",
            "properties": {
                "path": {
                    "description": "Its Storage path, users/<uid>/...",
                    "minLength": 1,
                    "title": "Path",
                    "type": "string"
                },
                "contentType": {
                    "description": "Its type",
                    "enum": [
                        "image/jpeg",
                        "image/png",
                        "application/pdf"
                    ],
                    "title": "Contenttype",
                    "type": "string"
                },
                "name": {
                    "description": "Its file name, from the path's last segment, sanitised",
                    "maxLength": 120,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                }
            },
            "required": [
                "path",
                "contentType",
                "name"
            ],
            "title": "ChatAttachmentRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "One turn of getConversationTurns: the user's text, the files sent\nwith it and the reply, never the tool steps. Each field restates\nChatTurn's.",
    "properties": {
        "seq": {
            "description": "Its place in the conversation",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
        },
        "userText": {
            "description": "What the user sent (\"\" when only files were)",
            "maxLength": 2000,
            "title": "Usertext",
            "type": "string"
        },
        "attachments": {
            "default": [],
            "description": "The files the user sent with it (none on a turn stored before attachments)",
            "items": {
                "$ref": "#/$defs/ChatAttachmentRow"
            },
            "maxItems": 4,
            "title": "Attachments",
            "type": "array"
        },
        "replyText": {
            "description": "The assistant's reply",
            "title": "Replytext",
            "type": "string"
        },
        "createdAt": {
            "description": "When it was saved",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        }
    },
    "required": [
        "seq",
        "userText",
        "replyText",
        "createdAt"
    ],
    "title": "ChatTurnRow",
    "type": "object",
    "additionalProperties": false
}