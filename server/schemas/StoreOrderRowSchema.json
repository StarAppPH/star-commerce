{
    "$defs": {
        "OrderItemRow": {
            "description": "One item of an order as a route sends it: OrderItem without its\nproductId. Each field restates OrderItem's, which\ntest_route_response_models.py's MIRRORS keeps in step.",
            "properties": {
                "name": {
                    "description": "Product name when ordered",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price paid, in the order currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units ordered",
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "name",
                "price",
                "quantity"
            ],
            "title": "OrderItemRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "One order as its store's admin sees it. Each field restates\nOrder's, which test_route_response_models.py's MIRRORS keeps in\nstep.",
    "properties": {
        "fulfillment": {
            "description": "How the customer gets it: pickup or delivery",
            "enum": [
                "pickup",
                "delivery"
            ],
            "title": "Fulfillment",
            "type": "string"
        },
        "deliveryFee": {
            "description": "What delivery adds to the total",
            "maximum": 10000000,
            "minimum": 0,
            "title": "Deliveryfee",
            "type": "number"
        },
        "deliveryAddress": {
            "anyOf": [
                {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Where it is delivered, as the customer typed it",
            "title": "Deliveryaddress"
        },
        "deliveryLatitude": {
            "anyOf": [
                {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The delivery pin's degrees north",
            "title": "Deliverylatitude"
        },
        "deliveryLongitude": {
            "anyOf": [
                {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The delivery pin's degrees east",
            "title": "Deliverylongitude"
        },
        "deliveryNotes": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The customer's notes for the delivery",
            "title": "Deliverynotes"
        },
        "_id": {
            "description": "Orders _id",
            "title": "Id",
            "type": "string"
        },
        "status": {
            "description": "Where the order is",
            "enum": [
                "pending",
                "paid",
                "completed",
                "cancelled"
            ],
            "title": "Status",
            "type": "string"
        },
        "items": {
            "description": "What was ordered",
            "items": {
                "$ref": "#/$defs/OrderItemRow"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        },
        "total": {
            "description": "What the order costs",
            "minimum": 0,
            "title": "Total",
            "type": "number"
        },
        "currency": {
            "description": "ISO 4217 code of the store's currency when ordered",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "contactNumber": {
            "description": "The customer's verified number",
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "title": "Contactnumber",
            "type": "string"
        },
        "createdAt": {
            "description": "When it was placed",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        },
        "paymentMethod": {
            "anyOf": [
                {
                    "enum": [
                        "card",
                        "gcash",
                        "maya",
                        "grabPay",
                        "bankTransfer"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "How the customer paid",
            "title": "Paymentmethod"
        },
        "paidAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "When it was paid",
            "title": "Paidat"
        },
        "expiresAt": {
            "description": "Unpaid by then, it is cancelled (UTC)",
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
        },
        "completedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "When it was handed over",
            "title": "Completedat"
        },
        "cancelledAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "When it was cancelled",
            "title": "Cancelledat"
        },
        "cancelReason": {
            "anyOf": [
                {
                    "enum": [
                        "expired",
                        "byStore",
                        "byCustomer"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Why it was cancelled",
            "title": "Cancelreason"
        },
        "refundedAt": {
            "anyOf": [
                {
                    "format": "date-time",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "When its payment was refunded",
            "title": "Refundedat"
        },
        "paymentReference": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The payment provider's id of the payment",
            "title": "Paymentreference"
        },
        "refundReference": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The payment provider's id of the refund",
            "title": "Refundreference"
        }
    },
    "required": [
        "fulfillment",
        "deliveryFee",
        "deliveryAddress",
        "deliveryLatitude",
        "deliveryLongitude",
        "deliveryNotes",
        "_id",
        "status",
        "items",
        "total",
        "currency",
        "contactNumber",
        "createdAt",
        "paymentMethod",
        "paidAt",
        "expiresAt",
        "completedAt",
        "cancelledAt",
        "cancelReason",
        "refundedAt",
        "paymentReference",
        "refundReference"
    ],
    "title": "StoreOrderRow",
    "type": "object",
    "additionalProperties": false
}