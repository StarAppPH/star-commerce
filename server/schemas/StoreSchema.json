{
    "$defs": {
        "DeliveryZone": {
            "description": "One area a store delivers to (deliveryZoneProblem holds its shape).",
            "properties": {
                "points": {
                    "description": "The corners in drawing order; the last joins the first",
                    "items": {
                        "$ref": "#/$defs/StoreLocation"
                    },
                    "maxItems": 100,
                    "minItems": 3,
                    "title": "Points",
                    "type": "array"
                }
            },
            "required": [
                "points"
            ],
            "title": "DeliveryZone",
            "type": "object",
            "additionalProperties": false
        },
        "StoreLocation": {
            "description": "Where a store is on the map, pinned by its admin.",
            "properties": {
                "latitude": {
                    "description": "Degrees north (negative: south)",
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "description": "Degrees east (negative: west)",
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                }
            },
            "required": [
                "latitude",
                "longitude"
            ],
            "title": "StoreLocation",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A Stores document. One per admin: ownerUserId (the admin's Users _id)\nis a unique index, and so is slug among the stores that have one\n(mongoDb.ensureIndexes).\n\nSign-up creates the admin's store empty: only its owner and currency.\nA store is *set up* once its slug is a string, which createUserStore\nsets together with the other details; until then every store reader\ntreats it as no store yet (StoreActions.SET_UP).",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "ownerUserId": {
            "description": "The admin's Users _id",
            "minLength": 1,
            "title": "Owneruserid",
            "type": "string"
        },
        "name": {
            "anyOf": [
                {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Store name shown to customers",
            "title": "Name"
        },
        "slug": {
            "anyOf": [
                {
                    "maxLength": 50,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The store's link name, e.g. bakery-a",
            "title": "Slug"
        },
        "currency": {
            "description": "ISO 4217 code every price of the store is in",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "What the store sells",
            "title": "Description"
        },
        "contactNumber": {
            "anyOf": [
                {
                    "pattern": "^\\+[1-9][0-9]{6,14}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Contact number, E.164",
            "title": "Contactnumber"
        },
        "address": {
            "anyOf": [
                {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Street address, as the admin typed it",
            "title": "Address"
        },
        "openingHours": {
            "anyOf": [
                {
                    "maxLength": 100,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Opening hours, free text",
            "title": "Openinghours"
        },
        "location": {
            "anyOf": [
                {
                    "$ref": "#/$defs/StoreLocation"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Map location; null until the admin pins it"
        },
        "deliveryZones": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/DeliveryZone"
                    },
                    "maxItems": 10,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Where it delivers, drawn on the map; null or empty: anywhere",
            "title": "Deliveryzones"
        },
        "photoStyle": {
            "anyOf": [
                {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The look of the store's product photos",
            "title": "Photostyle"
        },
        "primaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Main brand color, #RRGGBB",
            "title": "Primarycolor"
        },
        "secondaryColor": {
            "anyOf": [
                {
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Second brand color, #RRGGBB",
            "title": "Secondarycolor"
        },
        "voiceId": {
            "anyOf": [
                {
                    "pattern": "^[A-Za-z0-9]{1,64}$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The ElevenLabs voice its assistant speaks with; null: the default voice",
            "title": "Voiceid"
        },
        "createdAt": {
            "description": "When it was created",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
        }
    },
    "required": [
        "ownerUserId",
        "currency",
        "createdAt"
    ],
    "title": "Store",
    "type": "object",
    "additionalProperties": false
}