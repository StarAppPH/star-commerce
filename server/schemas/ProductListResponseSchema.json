{
    "$defs": {
        "ProductRow": {
            "description": "One product as a customer's list sends it. Each field restates\nProduct's, which test_route_response_models.py's MIRRORS keeps in\nstep.",
            "properties": {
                "_id": {
                    "description": "Products _id",
                    "title": "Id",
                    "type": "string"
                },
                "name": {
                    "description": "Product name",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "description": {
                    "anyOf": [
                        {
                            "maxLength": 500,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "What the product is",
                    "title": "Description"
                },
                "price": {
                    "description": "Price in the store's currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "inventory": {
                    "description": "Units free to sell; 0 is sold out",
                    "maximum": 1000000,
                    "minimum": 0,
                    "title": "Inventory",
                    "type": "integer"
                },
                "photoUrl": {
                    "anyOf": [
                        {
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The photo the shop shows: the url of one of the store's GeneratedPhotos (setProductPhoto)",
                    "title": "Photourl"
                }
            },
            "required": [
                "_id",
                "name",
                "price",
                "inventory"
            ],
            "title": "ProductRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "properties": {
        "currency": {
            "description": "ISO 4217 code of every price in the list",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "products": {
            "description": "The products, best sellers first",
            "items": {
                "$ref": "#/$defs/ProductRow"
            },
            "title": "Products",
            "type": "array"
        }
    },
    "required": [
        "currency",
        "products"
    ],
    "title": "ProductListResponse",
    "type": "object",
    "additionalProperties": false
}