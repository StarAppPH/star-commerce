{
    "$defs": {
        "DeliveryZoneResponse": {
            "description": "A zone as a route sends it: its policy and its shape.",
            "properties": {
                "name": {
                    "description": "What the zone is called, e.g. Makati",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "deliveryFee": {
                    "description": "What a delivery into the zone costs, in the store's currency; 0: free",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Deliveryfee",
                    "type": "number"
                },
                "deliveryDays": {
                    "description": "Days from payment until a delivery into the zone arrives",
                    "maximum": 365,
                    "minimum": 0,
                    "title": "Deliverydays",
                    "type": "integer"
                },
                "minimumOrder": {
                    "anyOf": [
                        {
                            "maximum": 10000000,
                            "minimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The smallest items total the zone takes, in the store's currency; null: no minimum",
                    "title": "Minimumorder"
                },
                "freeDeliveryFrom": {
                    "anyOf": [
                        {
                            "maximum": 10000000,
                            "minimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The items total from which delivery into the zone is free, in the store's currency; null: never free",
                    "title": "Freedeliveryfrom"
                },
                "points": {
                    "description": "The corners in drawing order; the last joins the first",
                    "items": {
                        "$ref": "#/$defs/StoreLocationResponse"
                    },
                    "maxItems": 100,
                    "minItems": 3,
                    "title": "Points",
                    "type": "array"
                }
            },
            "required": [
                "name",
                "deliveryFee",
                "deliveryDays",
                "minimumOrder",
                "freeDeliveryFrom",
                "points"
            ],
            "title": "DeliveryZoneResponse",
            "type": "object",
            "additionalProperties": false
        },
        "StoreLocationResponse": {
            "description": "A store's map location as a route sends it. Each field restates\nStoreLocation's, which test_route_response_models.py's MIRRORS keeps\nin step.",
            "properties": {
                "latitude": {
                    "description": "Degrees north (negative: south)",
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "description": "Degrees east (negative: west)",
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                }
            },
            "required": [
                "latitude",
                "longitude"
            ],
            "title": "StoreLocationResponse",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "Asks the shopper to pin where their delivery goes: a map and \"use\nwhere I am\", nothing typed (the model asks for the address in chat).\nAnswered with DeliveryPinAnswer.",
    "properties": {
        "kind": {
            "const": "deliveryPinForm",
            "description": "The form",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "storeLocation": {
            "anyOf": [
                {
                    "$ref": "#/$defs/StoreLocationResponse"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The store's pin, where the map opens; null until pinned"
        },
        "currency": {
            "anyOf": [
                {
                    "enum": [
                        "PHP",
                        "USD",
                        "EUR",
                        "GBP",
                        "JPY",
                        "SGD",
                        "AUD",
                        "CAD",
                        "HKD",
                        "CNY",
                        "KRW",
                        "MYR",
                        "THB",
                        "IDR",
                        "VND",
                        "INR",
                        "AED"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The zones' fees and totals are in it",
            "title": "Currency"
        },
        "deliveryZones": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/DeliveryZoneResponse"
                    },
                    "maxItems": 10,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The zones the store delivers to, with their policies",
            "title": "Deliveryzones"
        }
    },
    "required": [
        "kind",
        "formId",
        "storeLocation"
    ],
    "title": "DeliveryPinForm",
    "type": "object",
    "additionalProperties": false
}