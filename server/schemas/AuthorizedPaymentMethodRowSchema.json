{
    "$defs": {
        "BankAccountRow": {
            "description": "BankAccount as a route sends it (MIRRORS keeps it in step).",
            "properties": {
                "bankName": {
                    "description": "The bank, e.g. BDO",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Bankname",
                    "type": "string"
                },
                "accountName": {
                    "description": "The name the account is under, as the bank has it",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Accountname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "bankName",
                "accountName",
                "accountNumber"
            ],
            "title": "BankAccountRow",
            "type": "object",
            "additionalProperties": false
        },
        "EwalletAccountRow": {
            "description": "EwalletAccount as a route sends it. Each field restates\nEwalletAccount's, which test_route_response_models.py's MIRRORS keeps\nin step.",
            "properties": {
                "ewalletName": {
                    "description": "The e-wallet, e.g. GCash",
                    "maxLength": 60,
                    "minLength": 1,
                    "title": "Ewalletname",
                    "type": "string"
                },
                "accountNumber": {
                    "description": "The account or mobile number a customer pays to",
                    "maxLength": 40,
                    "minLength": 1,
                    "title": "Accountnumber",
                    "type": "string"
                }
            },
            "required": [
                "ewalletName",
                "accountNumber"
            ],
            "title": "EwalletAccountRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "AuthorizedPaymentMethod as a route sends it (MIRRORS keeps it in\nstep): every detail, null where the method takes none.",
    "properties": {
        "method": {
            "description": "The way to pay",
            "enum": [
                "cash",
                "card",
                "eWallet",
                "bankTransfer",
                "check",
                "crypto"
            ],
            "title": "Method",
            "type": "string"
        },
        "provider": {
            "anyOf": [
                {
                    "const": "demo",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The payment provider that takes it; null: paid by hand to the store only",
            "title": "Provider"
        },
        "eWallets": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/EwalletAccountRow"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "eWallet: the store's own accounts, paid to by hand",
            "title": "Ewallets"
        },
        "banks": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/BankAccountRow"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "bankTransfer: the store's bank accounts",
            "title": "Banks"
        },
        "checkPayees": {
            "anyOf": [
                {
                    "items": {
                        "description": "The account name a check is made out to",
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "check: the account names a check is made out to",
            "title": "Checkpayees"
        }
    },
    "required": [
        "method",
        "provider",
        "eWallets",
        "banks",
        "checkPayees"
    ],
    "title": "AuthorizedPaymentMethodRow",
    "type": "object",
    "additionalProperties": false
}