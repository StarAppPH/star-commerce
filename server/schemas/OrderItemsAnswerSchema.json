{
    "$defs": {
        "NewOrderItem": {
            "description": "One item of a createOrder call. Types only, no limits: the route\nchecks them, so a refusal names the item's position and never quotes\nthe value (NewProduct's reason).",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "title": "Productid",
                    "type": "string"
                },
                "quantity": {
                    "description": "Units to order",
                    "title": "Quantity",
                    "type": "integer"
                }
            },
            "required": [
                "productId",
                "quantity"
            ],
            "title": "NewOrderItem",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "A ShopProductsCard's picks.",
    "properties": {
        "kind": {
            "const": "orderItems",
            "description": "The answer",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "items": {
            "description": "What to order",
            "items": {
                "$ref": "#/$defs/NewOrderItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
        }
    },
    "required": [
        "kind",
        "formId",
        "items"
    ],
    "title": "OrderItemsAnswer",
    "type": "object",
    "additionalProperties": false
}