{
    "description": "A ChatUsage document: how many chat messages a customer, or a store's\ncustomers, sent on one day (UTC+8), or how many files they attached\n(customers, a store, all stores). Its _id is\n\"<kind>:<id>:<YYYY-MM-DD>\"; a TTL index on expireAt deletes it once the\nday is over.",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "count": {
            "description": "Messages (or files) sent that day",
            "minimum": 0,
            "title": "Count",
            "type": "integer"
        },
        "expireAt": {
            "description": "When it is deleted",
            "format": "date-time",
            "title": "Expireat",
            "type": "string"
        }
    },
    "required": [
        "count",
        "expireAt"
    ],
    "title": "ChatUsage",
    "type": "object",
    "additionalProperties": false
}