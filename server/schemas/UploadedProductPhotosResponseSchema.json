{
    "$defs": {
        "PhotoNotSavedRow": {
            "description": "A product whose uploaded photo could not be put on it.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "productName": {
                    "description": "Product name",
                    "minLength": 1,
                    "title": "Productname",
                    "type": "string"
                },
                "reason": {
                    "description": "Why it was not saved",
                    "minLength": 1,
                    "title": "Reason",
                    "type": "string"
                }
            },
            "required": [
                "productId",
                "productName",
                "reason"
            ],
            "title": "PhotoNotSavedRow",
            "type": "object",
            "additionalProperties": false
        },
        "PhotoShotRow": {
            "description": "One of the fixed shots every photo call makes (PhotoActions.PHOTO_SHOTS),\nits line as the store's brand colors write it: the edit box shows it\nread-only under the base prompt.",
            "properties": {
                "label": {
                    "description": "The shot's short name",
                    "minLength": 1,
                    "title": "Label",
                    "type": "string"
                },
                "line": {
                    "description": "The shot's line, added to the base prompt for its photo",
                    "minLength": 1,
                    "title": "Line",
                    "type": "string"
                }
            },
            "required": [
                "label",
                "line"
            ],
            "title": "PhotoShotRow",
            "type": "object",
            "additionalProperties": false
        },
        "UploadedProductPhotoRow": {
            "description": "A product whose uploaded photo is now on it: the original, kept as\none of the store's photos, and the prompt better photos are made from\nunless the admin edits it.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "productName": {
                    "description": "Product name",
                    "minLength": 1,
                    "title": "Productname",
                    "type": "string"
                },
                "photoId": {
                    "description": "The original's GeneratedPhotos _id",
                    "minLength": 1,
                    "title": "Photoid",
                    "type": "string"
                },
                "photoUrl": {
                    "description": "The original's download URL, now the product's photo",
                    "minLength": 1,
                    "title": "Photourl",
                    "type": "string"
                },
                "defaultPrompt": {
                    "description": "The prompt better photos are made from unless the admin edits it",
                    "maxLength": 2000,
                    "minLength": 1,
                    "title": "Defaultprompt",
                    "type": "string"
                }
            },
            "required": [
                "productId",
                "productName",
                "photoId",
                "photoUrl",
                "defaultPrompt"
            ],
            "title": "UploadedProductPhotoRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "What setUploadedProductPhotos sends: the products whose uploaded\nphoto is now on them, and those it could not be put on.",
    "properties": {
        "products": {
            "description": "The products whose photo is on, in the order sent",
            "items": {
                "$ref": "#/$defs/UploadedProductPhotoRow"
            },
            "maxItems": 50,
            "title": "Products",
            "type": "array"
        },
        "notSaved": {
            "description": "The products whose photo could not be saved; empty when all were",
            "items": {
                "$ref": "#/$defs/PhotoNotSavedRow"
            },
            "maxItems": 50,
            "title": "Notsaved",
            "type": "array"
        },
        "shots": {
            "description": "The shots better photos are made in, one per photo, for the card",
            "items": {
                "$ref": "#/$defs/PhotoShotRow"
            },
            "maxItems": 3,
            "title": "Shots",
            "type": "array"
        }
    },
    "required": [
        "products",
        "notSaved",
        "shots"
    ],
    "title": "UploadedProductPhotosResponse",
    "type": "object",
    "additionalProperties": false
}