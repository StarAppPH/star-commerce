{
    "$defs": {
        "CartScreenItemRow": {
            "description": "A cart row as the shop's cart panel shows it.",
            "properties": {
                "productId": {
                    "description": "The Products _id",
                    "minLength": 1,
                    "title": "Productid",
                    "type": "string"
                },
                "name": {
                    "description": "Product name",
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "price": {
                    "description": "Unit price now, in the store's currency",
                    "maximum": 10000000,
                    "minimum": 0,
                    "title": "Price",
                    "type": "number"
                },
                "quantity": {
                    "description": "Units in the cart",
                    "maximum": 1000000,
                    "minimum": 1,
                    "title": "Quantity",
                    "type": "integer"
                },
                "inventory": {
                    "description": "Units free to sell now; 0 is sold out",
                    "maximum": 1000000,
                    "minimum": 0,
                    "title": "Inventory",
                    "type": "integer"
                },
                "hasInventory": {
                    "description": "Decides whether this item has inventory, so when a customer orders it gets lessened. False: customers can order unlimited units (inventory is then 0 and never moves)",
                    "title": "Hasinventory",
                    "type": "boolean"
                },
                "photoUrl": {
                    "anyOf": [
                        {
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The product's photo; null when it has none",
                    "title": "Photourl"
                }
            },
            "required": [
                "productId",
                "name",
                "price",
                "quantity",
                "inventory",
                "hasInventory"
            ],
            "title": "CartScreenItemRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "The customer's cart as the shop's cart panel shows it.",
    "properties": {
        "currency": {
            "description": "ISO 4217 code of every price in the cart",
            "enum": [
                "PHP",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "SGD",
                "AUD",
                "CAD",
                "HKD",
                "CNY",
                "KRW",
                "MYR",
                "THB",
                "IDR",
                "VND",
                "INR",
                "AED"
            ],
            "title": "Currency",
            "type": "string"
        },
        "items": {
            "description": "The products still sold, in the order they were added",
            "items": {
                "$ref": "#/$defs/CartScreenItemRow"
            },
            "maxItems": 50,
            "title": "Items",
            "type": "array"
        },
        "subtotal": {
            "description": "Every item at its price now, times its quantity",
            "minimum": 0,
            "title": "Subtotal",
            "type": "number"
        }
    },
    "required": [
        "currency",
        "items",
        "subtotal"
    ],
    "title": "CartScreenResponse",
    "type": "object",
    "additionalProperties": false
}