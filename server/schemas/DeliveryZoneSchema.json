{
    "$defs": {
        "StoreLocation": {
            "description": "Where a store is on the map, pinned by its admin.",
            "properties": {
                "latitude": {
                    "description": "Degrees north (negative: south)",
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "description": "Degrees east (negative: west)",
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                }
            },
            "required": [
                "latitude",
                "longitude"
            ],
            "title": "StoreLocation",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "One area a store delivers to (deliveryZoneProblem holds its shape).",
    "properties": {
        "points": {
            "description": "The corners in drawing order; the last joins the first",
            "items": {
                "$ref": "#/$defs/StoreLocation"
            },
            "maxItems": 100,
            "minItems": 3,
            "title": "Points",
            "type": "array"
        }
    },
    "required": [
        "points"
    ],
    "title": "DeliveryZone",
    "type": "object",
    "additionalProperties": false
