{
    "$defs": {
        "PhotoChoiceRow": {
            "description": "One photo the admin may put on the product.",
            "properties": {
                "_id": {
                    "description": "GeneratedPhotos _id",
                    "title": "Id",
                    "type": "string"
                },
                "url": {
                    "description": "Its download URL",
                    "minLength": 1,
                    "title": "Url",
                    "type": "string"
                },
                "source": {
                    "description": "Styled, or the original",
                    "enum": [
                        "generated",
                        "original"
                    ],
                    "title": "Source",
                    "type": "string"
                },
                "prompt": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The prompt the model was given for it; null for the original, and on a card saved before each photo carried its own",
                    "title": "Prompt"
                }
            },
            "required": [
                "_id",
                "url",
                "source"
            ],
            "title": "PhotoChoiceRow",
            "type": "object",
            "additionalProperties": false
        }
    },
    "description": "The photos the admin picks one of for a product: its original and\nthe styled ones made from it. Answered with ProductPhotoAnswer.",
    "properties": {
        "kind": {
            "const": "productPhotoChoice",
            "description": "The card",
            "title": "Kind",
            "type": "string"
        },
        "formId": {
            "description": "Answer it with this id",
            "maxLength": 64,
            "minLength": 1,
            "title": "Formid",
            "type": "string"
        },
        "productId": {
            "description": "The Products _id",
            "title": "Productid",
            "type": "string"
        },
        "productName": {
            "description": "Product name",
            "title": "Productname",
            "type": "string"
        },
        "photos": {
            "description": "The original first, then the photos made",
            "items": {
                "$ref": "#/$defs/PhotoChoiceRow"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Photos",
            "type": "array"
        },
        "prompt": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The prompt the styled photos were made with; null when none were",
            "title": "Prompt"
        },
        "notGenerated": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Why fewer photos than asked were made; null when all were",
            "title": "Notgenerated"
        }
    },
    "required": [
        "kind",
        "formId",
        "productId",
        "productName",
        "photos",
        "notGenerated"
    ],
    "title": "ProductPhotoChoiceCard",
    "type": "object",
    "additionalProperties": false
}