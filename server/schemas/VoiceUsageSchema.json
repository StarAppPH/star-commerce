{
    "description": "A VoiceUsage document: the characters spoken of a customer at a\nstore, a store, or all stores on one day (UTC+8). Its _id is\n\"<kind>:<owner>:<YYYY-MM-DD>\" (usageCounters.usageKey); a TTL index on\nexpireAt deletes it once the day is over. (The speech tokens' per-minute\ncounters share the collection, keyed by the minute.)",
    "properties": {
        "_id": {
            "title": "Id",
            "type": "string"
        },
        "_version": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "Version"
        },
        "count": {
            "description": "Characters used that day",
            "minimum": 0,
            "title": "Count",
            "type": "integer"
        },
        "expireAt": {
            "description": "When it is deleted",
            "format": "date-time",
            "title": "Expireat",
            "type": "string"
        }
    },
    "required": [
        "count",
        "expireAt"
    ],
    "title": "VoiceUsage",
    "type": "object",
    "additionalProperties": false
}